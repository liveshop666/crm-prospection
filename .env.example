# ---------------------------------------------------------------
# Copie ce fichier en .env.local (en local) ou mets ces variables
# dans Vercel > Project > Settings > Environment Variables
# ---------------------------------------------------------------

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# ⚠️ SECRÈTE : ne jamais la partager ni la mettre côté navigateur
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Adresse publique du CRM (sert pour les liens trackés /r/xxx et les liens d'offre)
NEXT_PUBLIC_APP_URL=https://crm.tondomaine.fr

# Emails autorisés à se connecter au CRM (séparés par des virgules)
ALLOWED_EMAILS=toi@tondomaine.fr

# Clé que n8n envoie dans le header x-api-key. Génère-la avec :  openssl rand -hex 32
CRM_API_KEY=change-moi

# Ton site vitrine : là où le lien du SMS redirige (?ref=xxx est ajouté)
PUBLIC_SITE_URL=https://tonsite.fr
# Origines autorisées à envoyer le formulaire de contact vers le CRM
PUBLIC_SITE_ORIGINS=https://tonsite.fr,https://www.tonsite.fr


# Cal.com > Settings > Developer > Webhooks : le même secret des deux côtés (invente-le)
CALCOM_WEBHOOK_SECRET=change-moi

# Nom affiché sur la page d'offre envoyée au client
BRAND_NAME=Ma société
